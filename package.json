{
  "name": "checkin-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "db:generate": "bun --filter @checkin/db generate",
    "db:push": "bun --filter @checkin/db push",
    "db:seed": "bun --filter @checkin/db seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "dotenv": "^17.3.1",
    "ioredis": "^6.0.0",
    "meilisearch": "^0.62.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "eslint": "^9.39.4",
    "jsdom": "^28.1.0",
    "prisma": "^5.9.1",
    "turbo": "^2.4.4",
    "typescript": "^5",
    "vercel": "^54.11.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.3.11"
}
