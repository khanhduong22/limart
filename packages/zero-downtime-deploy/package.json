{
  "name": "@checkin/zero-downtime-deploy",
  "version": "1.0.0",
  "description": "Universal Zero-Downtime Deployment Toolkit: Docker Blue-Green Atomic Container Swap, Inode Directory Swap, Healthcheck Probe & CI/CD Templates",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "zero-downtime-deploy": "./dist/cli.js"
  },
  "exports": {
