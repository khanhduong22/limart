generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  role                  UserRole               @default(USER)
  isActive              Boolean                @default(true)
  luckyWheelAllowed     Boolean                @default(true)
  hourlyRate            Float                  @default(0)
  employmentType        EmploymentType         @default(PART_TIME)
  monthlySalary         Float                  @default(6000000)
  birthday              DateTime?
  startDate             DateTime?
  accounts              Account[]
  checkins              CheckIn[]
  luckyWheelHistory     LuckyWheelHistory[]
  adjustments           PayrollAdjustment[]
  requests              Request[]
  sessions              Session[]
  stickyNotes           StickyNote[]
  achievements          UserAchievement[]
  shifts                WorkShift[]
  tasks                 UserTask[]
  assignedTasks         TaskItem[]
  payslips              Payslip[]
  managerTasksCreated   ManagerTask[]          @relation("ManagerTaskCreator")
  managerTasksAssigned  ManagerTask[]          @relation("ManagerTaskAssignee")
  managerChecklistTasks ManagerChecklistTask[] @relation("ManagerChecklistAssignee")
  managerWeeklyTasks    ManagerWeeklyTask[]    @relation("ManagerWeeklyAssignee")
  staffTasksAllowed     Boolean                @default(false)
  staffTasksCreated     StaffTask[]            @relation("StaffTaskCreator")
  staffTasksAssigned    StaffTask[]            @relation("StaffTaskAssignee")
  shiftAuditLogs        ShiftAuditLog[]        @relation("UserShiftsLogs")
  changedShiftLogs      ShiftAuditLog[]        @relation("ChangedByShiftsLogs")
  shiftDuties           ShiftDuty[]            @relation("UserShiftDuties")
  shiftDutiesCreated    ShiftDuty[]            @relation("CreatedShiftDuties")
  sessionAudits         SessionAuditLog[]

  @@index([isActive])
  @@index([role, isActive])
  @@index([role, employmentType])
}

model WorkShift {
  id            Int         @id @default(autoincrement())
  userId        String
  start         DateTime
  end           DateTime
  shiftType     String?
  status        String      @default("APPROVED")
  isOpenForSwap Boolean     @default(false)
  isSenior      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  duties        ShiftDuty[]

  @@index([userId, start])
  @@index([start])
  @@index([start, end])
  @@index([isOpenForSwap, start])
  @@index([status, start])
  @@index([userId, status])
}

model ShiftAuditLog {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  userId      String
  action      String   // 'CREATE', 'UPDATE', 'DELETE', 'IMPORT', 'TAKE_SWAP'
  changedById String
  oldStart    DateTime?
  oldEnd      DateTime?
  newStart    DateTime?
  newEnd      DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation("UserShiftsLogs", fields: [userId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("ChangedByShiftsLogs", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([userId])
  @@index([changedById])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([shiftId, createdAt])
}

model Request {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String
  date      DateTime
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, createdAt])
  @@index([date])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  type      String   @default("INFO")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, createdAt])
  @@index([createdAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}

model StickyNote {
  id        String   @id @default(cuid())
  content   String
  color     String   @default("yellow")
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model PayrollAdjustment {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
  @@index([date])
  @@index([userId, createdAt])
}

model LuckyWheelPrize {
  id          String              @id @default(cuid())
  name        String
  description String?
  image       String?
  quantity    Int                 @default(0)
  remaining   Int                 @default(0)
  probability Float               @default(0)
  type        String              @default("PHYSICAL")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  value       Float               @default(0)
  history     LuckyWheelHistory[]

  @@index([active, createdAt])
}

model LuckyWheelHistory {
  id        String           @id @default(cuid())
  userId    String
  prizeId   String?
  prizeName String
  createdAt DateTime         @default(now())
  prize     LuckyWheelPrize? @relation(fields: [prizeId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([prizeId])
  @@index([prizeId, createdAt])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  code        String
  title       String?
  description String?
  icon        String?
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, unlockedAt])
}

model CheckIn {
  id        Int      @id @default(autoincrement())
  userId    String
  type      String
  timestamp DateTime @default(now())
  ipAddress String
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, timestamp, type])
  @@index([userId, type, timestamp])
  @@index([timestamp])
  @@index([type, timestamp])
}

model AllowedIP {
  id        Int      @id @default(autoincrement())
  prefix    String   @unique
  label     String?
  createdAt DateTime @default(now())
}

model Holiday {
  id         String   @id @default(cuid())
  date       DateTime @unique
  name       String
  multiplier Float    @default(1.0)
  createdAt  DateTime @default(now())

  @@index([date, multiplier])
}

enum UserRole {
  USER
  ADMIN
  PARTNER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum TaskStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

model TaskDefinition {
  id          String     @id @default(cuid())
  name        String
  description String?
  baseReward  Float      @default(0)
  unit        String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tasks       UserTask[]
  taskItems   TaskItem[]

  @@index([unit, active])
  @@index([active])
}

model TaskItem {
  id          String    @id @default(cuid())
  taskDefId   String
  title       String
  description String?
  deadline    DateTime?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CLOSED
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  taskDefinition TaskDefinition @relation(fields: [taskDefId], references: [id])
  assignee       User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  userTasks      UserTask[]

  @@index([taskDefId])
  @@index([assigneeId])
  @@index([assigneeId, status])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model UserTask {
  id             String         @id @default(cuid())
  userId         String
  taskDefId      String
  taskItemId     String?
  unitPrice      Float
  status         TaskStatus     @default(PENDING)
  quantity       Int            @default(1)
  evidenceLink   String?
  note           String?
  startedAt      DateTime       @default(now())
  submittedAt    DateTime?
  reviewedAt     DateTime?
  reviewedBy     String?
  finalAmount    Float?
  adminNote      String?
  bonusPenalty   Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskDefinition TaskDefinition @relation(fields: [taskDefId], references: [id])
  taskItem       TaskItem?      @relation(fields: [taskItemId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([userId, status, submittedAt])
  @@index([userId, createdAt])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@index([taskDefId])
  @@index([taskItemId])
  @@index([status, updatedAt])
  @@index([status, submittedAt])
}

model PayrollPeriod {
  id                 String           @id @default(cuid())
  month              Int
  year               Int
  status             String           @default("OPEN") // OPEN, CLOSED, LOCKED
  bonusPercent       Float            @default(0) // Global bonus for the month
  bonusTargets       EmploymentType[] @default([PART_TIME])
  excludedBonusUsers String[]         @default([])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([month, year])
}

model Payslip {
  id          String    @id @default(cuid())
  userId      String
  month       Int
  year        Int
  content     Json // Snapshot of all stats (hours, rate, calculations)
  netSalary   Float // Final amount for easy querying
  status      String    @default("PENDING") // PAID, PENDING
  emailSentAt DateTime? // When salary email was sent
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([month, year])
  @@index([status, month, year])
}

model Document {
  id        String          @id @default(cuid())
  path      String          @unique
  title     String
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  chunks    DocumentChunk[]

  @@index([createdAt])
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector")? // pgvector extension
  createdAt  DateTime               @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([documentId, createdAt])
}

model ManagerTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  isUrgent    Boolean   @default(false)
  isImportant Boolean   @default(false)
  status      String    @default("TODO") // TODO, DOING, DONE, DELEGATED
  assigneeId  String?
  parentId    String?
  startDate   DateTime?
  deadline    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignee  User?         @relation("ManagerTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User          @relation("ManagerTaskCreator", fields: [createdById], references: [id])
  parent    ManagerTask?  @relation("ManagerTaskSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks  ManagerTask[] @relation("ManagerTaskSubtasks")

  @@index([assigneeId])
  @@index([assigneeId, status])
  @@index([assigneeId, createdAt])
  @@index([status])
  @@index([status, deadline])
  @@index([createdById])
  @@index([parentId])
}

model StaffTask {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("TODO") // TODO, DOING, DONE, APPROVED, REJECTED
  assigneeId   String
  createdById  String
  startDate    DateTime?
  deadline     DateTime?
  submittedAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  adminNote    String?
  evidenceLink String?
  evidenceNote String?

  assignee  User @relation("StaffTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User @relation("StaffTaskCreator", fields: [createdById], references: [id])

  @@index([assigneeId, startDate])
  @@index([assigneeId, createdAt])
  @@index([createdById])
  @@index([assigneeId, status])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model ManagerChecklistTask {
  id          String   @id @default(cuid())
  title       String
  description String?
  assigneeId  String
  active      Boolean  @default(true)
  targetDate  String?  // format: YYYY-MM-DD, null means daily recurring
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee    User                         @relation("ManagerChecklistAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  completions ManagerChecklistCompletion[]

  @@index([assigneeId, active])
  @@index([targetDate])
}

model ManagerChecklistCompletion {
  id          String    @id @default(cuid())
  taskId      String
  date        String // format: YYYY-MM-DD
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  task ManagerChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, date])
  @@index([taskId])
  @@index([date, completed])
}

model ManagerWeeklyTask {
  id            String    @id @default(cuid())
  title         String
  description   String?
  assigneeId    String
  weekStart     DateTime
  weekEnd       DateTime
  completed     Boolean   @default(false)
  completedAt   DateTime?
  explanation   String?
  isCarriedOver Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignee      User      @relation("ManagerWeeklyAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([assigneeId, weekStart])
  @@index([assigneeId, completed])
  @@index([assigneeId, completed, weekStart])
  @@index([weekStart])
  @@index([createdAt])
}

model ShiftDuty {
  id          String     @id @default(cuid())
  shiftId     Int?
  userId      String
  createdById String
  date        DateTime
  title       String
  description String?
  isCompleted Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation("UserShiftDuties", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("CreatedShiftDuties", fields: [createdById], references: [id])
  shift       WorkShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, isCompleted])
  @@index([userId, createdAt])
  @@index([createdById])
  @@index([date])
  @@index([shiftId])
  @@index([shiftId, userId])
  @@index([shiftId, isCompleted])
  @@index([date, isCompleted])
}

model SessionAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // LOGIN, LOGOUT, CHECKIN, CHECKOUT, FAILED_LOGIN
  status    String   @default("SUCCESS") // SUCCESS, FAILED
  ipAddress String?
  userAgent String?
  device    String?  // Mobile, Desktop, Tablet
  city      String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([action, status, createdAt])
  @@index([createdAt])
}

